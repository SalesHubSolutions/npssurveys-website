  "csat-case-close": "<div class=\"kick\">Salesforce admin how-to</div><h1 style=\"font-size:70px\">CSAT on <em>case close</em></h1><div style=\"margin-top:40px;background:#fff;border-radius:28px;padding:28px 28px 22px;box-shadow:0 20px 50px rgba(0,0,0,.25)\"><div style=\"display:flex;gap:22px;align-items:center;background:#F4F7FF;border:2px solid #DCE4F7;border-radius:18px;padding:16px 22px\"><div style=\"flex:none;width:50px;height:50px;border-radius:50%;background:#0C184A;color:#fff;display:grid;place-items:center;font-weight:800;font-size:26px\">1</div><div><div style=\"font-size:31px;font-weight:800;color:#0C184A\">Case closes</div><div style=\"font-size:24px;font-weight:600;color:#5E6B98;margin-top:2px\">status moves into a closed value</div></div></div><div style=\"width:0;height:0;margin:7px auto;border-left:13px solid transparent;border-right:13px solid transparent;border-top:15px solid #1E54E8\"></div><div style=\"display:flex;gap:22px;align-items:center;background:#F4F7FF;border:2px solid #DCE4F7;border-radius:18px;padding:16px 22px\"><div style=\"flex:none;width:50px;height:50px;border-radius:50%;background:#0C184A;color:#fff;display:grid;place-items:center;font-weight:800;font-size:26px\">2</div><div><div style=\"font-size:31px;font-weight:800;color:#0C184A\">Survey sends</div><div style=\"font-size:24px;font-weight:600;color:#5E6B98;margin-top:2px\">once, to the case contact</div></div></div><div style=\"width:0;height:0;margin:7px auto;border-left:13px solid transparent;border-right:13px solid transparent;border-top:15px solid #1E54E8\"></div><div style=\"display:flex;gap:22px;align-items:center;background:#F4F7FF;border:2px solid #DCE4F7;border-radius:18px;padding:16px 22px\"><div style=\"flex:none;width:50px;height:50px;border-radius:50%;background:#0C184A;color:#fff;display:grid;place-items:center;font-weight:800;font-size:26px\">3</div><div><div style=\"font-size:31px;font-weight:800;color:#0C184A\">They rate it</div><div style=\"font-size:24px;font-weight:600;color:#5E6B98;margin-top:2px\">one rating + one \u201cwhy\u201d question</div></div></div><div style=\"width:0;height:0;margin:7px auto;border-left:13px solid transparent;border-right:13px solid transparent;border-top:15px solid #1E54E8\"></div><div style=\"display:flex;gap:22px;align-items:center;background:#F4F7FF;border:2px solid #DCE4F7;border-radius:18px;padding:16px 22px\"><div style=\"flex:none;width:50px;height:50px;border-radius:50%;background:#0C184A;color:#fff;display:grid;place-items:center;font-weight:800;font-size:26px\">4</div><div><div style=\"font-size:31px;font-weight:800;color:#0C184A\">Answer saved</div><div style=\"font-size:24px;font-weight:600;color:#5E6B98;margin-top:2px\">on the Case and Contact</div></div></div><div style=\"width:0;height:0;margin:7px auto;border-left:13px solid transparent;border-right:13px solid transparent;border-top:15px solid #1E54E8\"></div><div style=\"display:flex;gap:22px;align-items:center;background:#1E54E8;border:2px solid #1E54E8;border-radius:18px;padding:16px 22px\"><div style=\"flex:none;width:50px;height:50px;border-radius:50%;background:#FFE443;color:#0C184A;display:grid;place-items:center;font-weight:800;font-size:26px\">5</div><div><div style=\"font-size:31px;font-weight:800;color:#fff\">Owner acts</div><div style=\"font-size:24px;font-weight:600;color:#DCE7FF;margin-top:2px\">a low score gets a follow-up</div></div></div></div><div class=\"foot\"><div class=\"url\">npssurveys.com/insights</div><div class=\"fine\">Step-by-step guide with a go-live checklist.</div></div>",
  "go-live-checklist": "<div class=\"kick\">Go-live checklist</div><h1 style=\"font-size:70px\">Test it <em>before</em> go-live</h1><div style=\"margin-top:40px;background:#fff;border-radius:28px;padding:28px 28px 22px;box-shadow:0 20px 50px rgba(0,0,0,.25)\"><div style=\"display:flex;gap:22px;align-items:center;background:#F4F7FF;border:2px solid #DCE4F7;border-radius:18px;padding:16px 22px\"><div style=\"flex:none;width:50px;height:50px;border-radius:50%;background:#0C184A;color:#fff;display:grid;place-items:center;font-weight:800;font-size:26px\">1</div><div><div style=\"font-size:31px;font-weight:800;color:#0C184A\">Close a test case</div><div style=\"font-size:24px;font-weight:600;color:#5E6B98;margin-top:2px\">exactly one survey arrives</div></div></div><div style=\"width:0;height:0;margin:7px auto;border-left:13px solid transparent;border-right:13px solid transparent;border-top:15px solid #1E54E8\"></div><div style=\"display:flex;gap:22px;align-items:center;background:#F4F7FF;border:2px solid #DCE4F7;border-radius:18px;padding:16px 22px\"><div style=\"flex:none;width:50px;height:50px;border-radius:50%;background:#0C184A;color:#fff;display:grid;place-items:center;font-weight:800;font-size:26px\">2</div><div><div style=\"font-size:31px;font-weight:800;color:#0C184A\">Edit the closed case</div><div style=\"font-size:24px;font-weight:600;color:#5E6B98;margin-top:2px\">no second survey goes out</div></div></div><div style=\"width:0;height:0;margin:7px auto;border-left:13px solid transparent;border-right:13px solid transparent;border-top:15px solid #1E54E8\"></div><div style=\"display:flex;gap:22px;align-items:center;background:#F4F7FF;border:2px solid #DCE4F7;border-radius:18px;padding:16px 22px\"><div style=\"flex:none;width:50px;height:50px;border-radius:50%;background:#0C184A;color:#fff;display:grid;place-items:center;font-weight:800;font-size:26px\">3</div><div><div style=\"font-size:31px;font-weight:800;color:#0C184A\">Answer the survey</div><div style=\"font-size:24px;font-weight:600;color:#5E6B98;margin-top:2px\">the score shows on the Case</div></div></div><div style=\"width:0;height:0;margin:7px auto;border-left:13px solid transparent;border-right:13px solid transparent;border-top:15px solid #1E54E8\"></div><div style=\"display:flex;gap:22px;align-items:center;background:#1E54E8;border:2px solid #1E54E8;border-radius:18px;padding:16px 22px\"><div style=\"flex:none;width:50px;height:50px;border-radius:50%;background:#FFE443;color:#0C184A;display:grid;place-items:center;font-weight:800;font-size:26px\">4</div><div><div style=\"font-size:31px;font-weight:800;color:#fff\">Give a low score</div><div style=\"font-size:24px;font-weight:600;color:#DCE7FF;margin-top:2px\">the owner gets the follow-up</div></div></div></div><div class=\"foot\"><div class=\"url\">npssurveys.com/insights</div><div class=\"fine\">Run it in a sandbox first, then repeat in production.</div></div>",
  "detractor-case": "<div class=\"kick\">Knowledge center</div><h1 style=\"font-size:70px\">Working a <em>detractor</em> case</h1><div style=\"margin-top:40px;background:#fff;border-radius:28px;padding:28px 28px 22px;box-shadow:0 20px 50px rgba(0,0,0,.25)\"><div style=\"display:flex;gap:22px;align-items:center;background:#F4F7FF;border:2px solid #DCE4F7;border-radius:18px;padding:16px 22px\"><div style=\"flex:none;width:50px;height:50px;border-radius:50%;background:#0C184A;color:#fff;display:grid;place-items:center;font-weight:800;font-size:26px\">1</div><div><div style=\"font-size:31px;font-weight:800;color:#0C184A\">Pick it up</div><div style=\"font-size:24px;font-weight:600;color:#5E6B98;margin-top:2px\">open the P1 case from your queue</div></div></div><div style=\"width:0;height:0;margin:7px auto;border-left:13px solid transparent;border-right:13px solid transparent;border-top:15px solid #1E54E8\"></div><div style=\"display:flex;gap:22px;align-items:center;background:#F4F7FF;border:2px solid #DCE4F7;border-radius:18px;padding:16px 22px\"><div style=\"flex:none;width:50px;height:50px;border-radius:50%;background:#0C184A;color:#fff;display:grid;place-items:center;font-weight:800;font-size:26px\">2</div><div><div style=\"font-size:31px;font-weight:800;color:#0C184A\">Read first</div><div style=\"font-size:24px;font-weight:600;color:#5E6B98;margin-top:2px\">score, comment and case history</div></div></div><div style=\"width:0;height:0;margin:7px auto;border-left:13px solid transparent;border-right:13px solid transparent;border-top:15px solid #1E54E8\"></div><div style=\"display:flex;gap:22px;align-items:center;background:#F4F7FF;border:2px solid #DCE4F7;border-radius:18px;padding:16px 22px\"><div style=\"flex:none;width:50px;height:50px;border-radius:50%;background:#0C184A;color:#fff;display:grid;place-items:center;font-weight:800;font-size:26px\">3</div><div><div style=\"font-size:31px;font-weight:800;color:#0C184A\">Reach out</div><div style=\"font-size:24px;font-weight:600;color:#5E6B98;margin-top:2px\">within one business day</div></div></div><div style=\"width:0;height:0;margin:7px auto;border-left:13px solid transparent;border-right:13px solid transparent;border-top:15px solid #1E54E8\"></div><div style=\"display:flex;gap:22px;align-items:center;background:#F4F7FF;border:2px solid #DCE4F7;border-radius:18px;padding:16px 22px\"><div style=\"flex:none;width:50px;height:50px;border-radius:50%;background:#0C184A;color:#fff;display:grid;place-items:center;font-weight:800;font-size:26px\">4</div><div><div style=\"font-size:31px;font-weight:800;color:#0C184A\">Fix it</div><div style=\"font-size:24px;font-weight:600;color:#5E6B98;margin-top:2px\">or explain, and agree a next step</div></div></div><div style=\"width:0;height:0;margin:7px auto;border-left:13px solid transparent;border-right:13px solid transparent;border-top:15px solid #1E54E8\"></div><div style=\"display:flex;gap:22px;align-items:center;background:#1E54E8;border:2px solid #1E54E8;border-radius:18px;padding:16px 22px\"><div style=\"flex:none;width:50px;height:50px;border-radius:50%;background:#FFE443;color:#0C184A;display:grid;place-items:center;font-weight:800;font-size:26px\">5</div><div><div style=\"font-size:31px;font-weight:800;color:#fff\">Close the loop</div><div style=\"font-size:24px;font-weight:600;color:#DCE7FF;margin-top:2px\">record what you did, then close</div></div></div></div><div class=\"foot\"><div class=\"url\">npssurveys.com/#learn</div><div class=\"fine\">Free guides in the Learning Center.</div></div>"
